# =====================================================================
# rag-evaluator 環境設定 —— 換一個受測 RAG 系統時,照本檔五個區段逐一檢查。
# 本檔已以 nas-rag 為範例填好;複製成 .env 後改成你的值。
# (只有第 1、2 區段是程式會讀的環境變數;第 3–5 區段是 checklist,
#  對應的設定放在 system.yaml / golden.jsonl,原因見各區段說明。)
# =====================================================================

# --- 1. Judge:評分用 LLM ---------------------------------------------
# 原則:judge 要與受測系統的「回答模型」不同家,避免同源偏袒。
# 忠實度證據多為頁面圖片時,judge 必須是多模態模型。
GEMINI_API_KEY=your-key-here
RAG_EVAL_JUDGE_MODEL=gemini-2.5-flash
RAG_EVAL_JUDGE_QPS=1.0

# --- 2. 向量庫:建 corpus 用(忠實度證據來源)-------------------------
# `rag-eval corpus from-qdrant --collection <c> -o corpus.jsonl` 的預設 URL
# (CLI --url 可覆蓋)。新系統若也用 Qdrant 且 payload 有 source/page 等
# 欄位可直接沿用;否則參考 corpus.py 的 convert_nas_rag_manifest 寫轉換。
# 沒有 corpus 評測照跑,只是忠實度退化成「只看 sources 附帶文字」。
RAG_EVAL_QDRANT_URL=http://localhost:6333

# --- 3. 受測系統:連線設定 --------------------------------------------
# `./run-eval.sh` 用下列變數生成 runs/<run-id>/system.yaml,再拿它跑評測。
# 設定與結果落在同一個目錄,溯源天然;repo 根目錄那份手寫的 system.yaml
# 保留給分步流程,script 不會動它。
# 改了任一項就要換 run-id——run manifest 釘住整份 system_config。
# (要手動跑分步流程的話,自己編 system.yaml 即可,不必設這一區。)

# 必須含完整路徑!adapter 直接 POST 這個 URL,不會自動補 /v1/query。
# 只拿得到前端網站時填 http://<web-host>/api/v1/query(nginx 會剝 /api 反代)。
RAG_EVAL_ENDPOINT=http://localhost:8020/v1/query
RAG_EVAL_COLLECTION=gavin_test        # 多個以逗號分隔
RAG_EVAL_TOP_K=5
RAG_EVAL_TIMEOUT_S=300
RAG_EVAL_ADAPTER=nas_rag              # 註冊於 adapters/nas_rag.py 的 ADAPTERS

# 認證:留空 = 不送。token 原樣放進 header,不會自動補 "Bearer " 前綴,
# 所以 Authorization 與 X-API-Key 兩種風格用同一組變數就能表達。
# 值只活在環境變數裡:system.yaml 與 run manifest 只記「auth_env: RAG_EVAL_AUTH_TOKEN」
# 這個名字,秘密不會落盤。
RAG_EVAL_AUTH_TOKEN=
RAG_EVAL_AUTH_HEADER=Authorization

# true=正常驗證;false=略過(內網自簽憑證);或填 CA bundle 路徑。
RAG_EVAL_TLS_VERIFY=true

# 診斷(留空=不啟用):前者用更大的 top_k 再打一次做截斷歸因,
# 後者依 corpus 的 type 欄位分桶。兩者都會讓報表多出「特化診斷」段落。
RAG_EVAL_CUTOFF_PROBE_TOP_K=20
RAG_EVAL_TYPE_BUCKETS=true

# 新系統 API 契約不同(欄位名/協定)→ 仿 nas_rag.py 寫 ~50 行 adapter,
# 註冊進 ADAPTERS,並錄一份真實回應當 contract test fixture。
# sources 最低要求:每筆有 (document, page)。

# --- 4. 黃金集:唯一必然的人力投入 ------------------------------------
# 出題:generate-golden-questions skill(agent 親讀頁面 PNG)→ review.csv
# 核可:人工填 approved 欄
# 定稿:uv run rag-eval dataset finalize --review review.csv -o golden.jsonl
# 建議 30–50 題,必含跨頁題與不可答題。

# --- 5. 換系統要檢查的三個內建假設 ------------------------------------
# a. 檢索單位是「文件的第幾頁」:A 層全部用 (document, page) 對比 gold。
#    新系統檢索單位若是 chunk 而非頁,是唯一需要動核心設計的情況。
# b. 拒答句式寫死中文(eval/refusal.py:「找不到相關資訊」等):
#    新系統拒答措辭不同就要補 pattern,否則 false_refusal/hallucination 失準。
# c. 數值單位字典偏台灣財報(eval/numeric.py DEFAULT_UNITS:NTD千元/億元/美元…):
#    新領域單位要補;字典外單位會走 unknown_unit 升級 judge,不誤判但規則覆蓋率降。
